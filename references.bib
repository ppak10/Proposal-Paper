	journal = {Materials Research Letters},
	publisher = {Taylor \& Francis},
	author = {Cunningham, Ross and Nicolas, Andrea and Madsen, John and Fodran, Eric and Anagnostou, Elias and Sangid, Michael D. and Rollett, Anthony D.},
